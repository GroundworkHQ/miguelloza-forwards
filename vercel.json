{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/inner-edge",
      "destination": "https://inneredgescalping.com/",
      "permanent": false
    },
    {
      "source": "/inner-edge/",
      "destination": "https://inneredgescalping.com/",
      "permanent": false
    },
    {
      "source": "/inner-edge/:path*",
      "destination": "https://inneredgescalping.com/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/manscaped-outdoors",
      "destination": "https://groundworkhq.github.io/manscaped-outdoors/index.html"
    },
    {
      "source": "/manscaped-outdoors/",
      "destination": "https://groundworkhq.github.io/manscaped-outdoors/index.html"
    },
    {
      "source": "/manscaped-outdoors/:path*",
      "destination": "https://groundworkhq.github.io/manscaped-outdoors/:path*"
    },
    {
      "source": "/neurowaves",
      "destination": "https://groundworkhq.github.io/neurowaves/index.html"
    },
    {
      "source": "/neurowaves/",
      "destination": "https://groundworkhq.github.io/neurowaves/index.html"
    },
    {
      "source": "/neurowaves/:path*/",
      "destination": "https://groundworkhq.github.io/neurowaves/:path*/index.html"
    },
    {
      "source": "/neurowaves/:path*",
      "destination": "https://groundworkhq.github.io/neurowaves/:path*"
    }
  ]
}
